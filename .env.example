# Rempli automatiquement par ./install.sh. Ne jamais commiter de vraies valeurs.

# Nom de domaine public du serveur (ex. ecole.mondomaine.fr)
DOMAIN=

# « caddy » : Caddy intégré obtient le certificat HTTPS sur les ports 80/443.
# « router » : votre reverse proxy (Zoraxy, Nginx Proxy Manager…) gère HTTPS et
#   envoie tout le domaine vers EXPOSE_ADDR:ROUTER_PORT, avec une seule règle.
COMPOSE_PROFILES=caddy

# Base SQLite et clé Fernet de chiffrement des connexions École Directe
ECO_TO_ALEXA_DB=/data/ec_to_alexa.sqlite3
ECO_TO_ALEXA_SECRET_KEY=
ECO_TO_ALEXA_SECURE_COOKIES=1

# Liaison de compte Alexa (Account Linking)
ALEXA_OAUTH_CLIENT_ID=
ALEXA_OAUTH_CLIENT_SECRET=
# Vendor ID Amazon : génère les trois URL de redirection Alexa autorisées.
ALEXA_VENDOR_ID=
# Optionnel : URL de redirection supplémentaires, séparées par des virgules.
ALEXA_OAUTH_REDIRECT_URI=
# Identifiant de la skill (amzn1.ask.skill....) : les requêtes d'une autre skill sont refusées.
ALEXA_SKILL_ID=

# Adresse d'écoute des ports ci-dessous sur l'hôte (0.0.0.0 = réseau local en HTTP).
EXPOSE_ADDR=127.0.0.1
# Ports sur l'hôte. Zoraxy utilise 8000 pour son interface : changez WEB_PORT en cas de conflit.
WEB_PORT=8000
OAUTH_PORT=8001
ROUTER_PORT=8080
# Port HTTPS du routeur (certificat interne) : cible conseillée pour Zoraxy sur une autre machine.
ROUTER_TLS_PORT=8443

# Uniquement pour le script CLI ecole_directe.py
ECOLE_DIRECTE_IDENTIFIANT=
ECOLE_DIRECTE_MOT_DE_PASSE=

# Webhook /alexa : à 1 uniquement pour des tests locaux sans signature Amazon.
ECO_TO_ALEXA_ALLOW_UNSIGNED_LOCAL=0
# Proxys autorisés à fournir X-Forwarded-For (adresses ou plages CIDR, séparées par des virgules).
# Avec le Caddy de docker-compose : le réseau Docker, ex. 172.16.0.0/12
ECO_TO_ALEXA_TRUSTED_PROXIES=
# URL publique du site (lien « Créer un compte » de la page de liaison Alexa).
ECO_TO_ALEXA_PUBLIC_URL=
# Fuseau horaire utilisé pour « aujourd'hui » et « demain ».
ECO_TO_ALEXA_TIMEZONE=Europe/Paris
